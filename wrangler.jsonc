{
  "name": "aicdb",
  "main": "worker/index.js",
  "compatibility_date": "2024-12-01",
  // Set after: wrangler whoami  →  paste account_id here for deploy from CI
  // "account_id": "your-cloudflare-account-id",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "enable_containers": false
  }
}
